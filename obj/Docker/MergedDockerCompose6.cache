name: dockercompose14091339157623210973
services:
  loggerservice:
    build:
      context: D:\intership
      dockerfile: LoggerService/Dockerfile
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      DOTNET_ENVIRONMENT: Development
      RabbitMQ__HostName: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Port: "5672"
      RabbitMQ__UserName: guest
    image: loggerservice
    networks:
      default: null
      shared_network: null
    volumes:
      - type: bind
        source: D:\intership\LoggerService\logs
        target: /app/logs
        bind: {}
  product:
    build:
      context: D:\intership
      dockerfile: GrpcServer/Dockerfile
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "5000"
      RabbitMQ__HostName: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Port: "5672"
      RabbitMQ__UserName: guest
    image: product
    networks:
      default: null
      shared_network: null
    ports:
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
  product.database:
    container_name: product.database
    environment:
      POSTGRES_DB: productdb
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5431"
        protocol: tcp
  rabbitmq:
    container_name: rabbitmq
    environment:
      RABBITMQ_DEFAULT_PASS: guest
      RABBITMQ_DEFAULT_USER: guest
    healthcheck:
      test:
        - CMD
        - rabbitmq-diagnostics
        - ping
      timeout: 5s
      interval: 10s
      retries: 5
      start_period: 20s
    image: rabbitmq:3-management
    networks:
      default: null
      shared_network: null
    ports:
      - mode: ingress
        target: 5672
        published: "5672"
        protocol: tcp
      - mode: ingress
        target: 15672
        published: "15672"
        protocol: tcp
    volumes:
      - type: volume
        source: rabbitmq_data
        target: /var/lib/rabbitmq
        volume: {}
  tasktracker:
    build:
      context: D:\intership
      dockerfile: TaskTracker/Dockerfile
    depends_on:
      rabbitmq:
        condition: service_healthy
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "5100"
      RabbitMQ__HostName: rabbitmq
      RabbitMQ__Password: guest
      RabbitMQ__Port: "5672"
      RabbitMQ__UserName: guest
    image: tasktracker
    networks:
      default: null
      shared_network: null
    ports:
      - mode: ingress
        target: 5100
        published: "5100"
        protocol: tcp
  tasktracker.database:
    container_name: tasktracker.database
    environment:
      POSTGRES_DB: TaskTracker
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:latest
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
networks:
  default:
    name: dockercompose14091339157623210973_default
  shared_network:
    name: my-shared-network
    driver: bridge
volumes:
  rabbitmq_data:
    name: dockercompose14091339157623210973_rabbitmq_data